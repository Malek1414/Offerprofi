# Required for the full local product flow
DATABASE_URL=postgresql://app_login:dev-only-password@localhost:5432/angebot_dev
CHAT_SESSION_SECRET=replace-with-at-least-32-random-characters
ANTHROPIC_API_KEY=

# Offerprofi identity and deployment URLs
PRODUCT_NAME=Offerprofi
CHAT_DOMAIN=http://localhost:3000
INBOUND_DOMAIN=in.offerprofi.invalid
SENDING_DOMAIN=mail.offerprofi.invalid

# Required before publishing the legal pages
LEGAL_COMPANY_NAME=
LEGAL_REPRESENTATIVE=
LEGAL_STREET=
LEGAL_POSTAL_CODE=
LEGAL_CITY=
LEGAL_COUNTRY=Deutschland
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_REGISTER_COURT=
LEGAL_REGISTER_NUMBER=
LEGAL_VAT_ID=
PRIVACY_CONTACT_EMAIL=

# Optional WhatsApp/Unipile channel
UNIPILE_API_KEY=
UNIPILE_BASE_URL=
UNIPILE_ACCOUNT_ID=

# Optional prospect enrichment (Phase C). Every one of these may be empty:
# unset, the enrichment worker does nothing and the rest of the product is
# unaffected. Search degrades to a typed "not configured" result rather than
# throwing, which is the normal state of a development machine.
TAVILY_API_KEY=
# The enrichment worker runs as a real platform_operators row, because the
# enrichment tables are behind is_platform_operator() and there is exactly one
# identity mechanism. Without this, nothing is claimed and nothing is spent.
ENRICHMENT_OPERATOR_USER_ID=
# Must be real and contactable before crawling anything that is not ours. Left
# empty it is derived from PRODUCT_NAME and CHAT_DOMAIN, which on placeholder
# branding points at localhost — so crawlerIsContactable() is false and a real
# import should refuse to run. See open question #1.
CRAWLER_USER_AGENT=
