{
  "name": "quote-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Quote automation for small event agencies (DACH). See PRODUCT_SPEC.md.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:invariants": "vitest run tests/invariants",
    "test:db": "./db/test.sh",
    "progress": "node scripts/build-progress.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "next": "^15.5.0",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
